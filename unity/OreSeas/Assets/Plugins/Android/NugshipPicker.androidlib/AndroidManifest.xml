<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Transparent helper activity: opens the system photo picker and hands a cropped 128x128 PNG back to Unity.
             No storage permission: the system picker grants one-time read access to the chosen image only. -->
        <activity android:name="com.nugship.picker.PickerActivity"
                  android:theme="@android:style/Theme.Translucent.NoTitleBar"
                  android:exported="false"
                  android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode" />
    </application>
</manifest>
